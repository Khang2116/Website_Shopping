@model IEnumerable<Product>
@{
    ViewData["Title"] = "Trang chủ";
}

<section class="new_arrivals_area section_padding_100_0 clearfix">
    <div class="container">
        <div class="row">
            <div class="col-12 text-center mb-4">
                <h2>New Arrivals</h2>
            </div>
        </div>
        <div class="row">
            @if (!Model.Any())
            {
                <div class="col-12 text-center">
                    <p>Chưa có sản phẩm nào. Vui lòng thêm sản phẩm ở trang quản trị.</p>
                </div>
            }
            @foreach (var item in Model)
            {
                <div class="col-12 col-sm-6 col-lg-3 single_gallery_item wow fadeInUpBig">
                    <div class="product-img">
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="~/img/products/@item.ImageUrl" alt="@item.Name">
                        }
                        <div class="product-quicview">
                            <a asp-controller="Product" asp-action="ProductDetails" asp-route-id="@item.Id"><i class="ti-eye"></i></a>
                        </div>
                    </div>
                    <div class="product-description">
                        <h4 class="product-price">@item.Price.ToString("N0") đ</h4>
                        <p>@item.Name</p>
                        @if (item.Id > 0)
                        {
                            <a asp-controller="Product" asp-action="ProductDetails" asp-route-id="@item.Id" class="add-to-cart-btn">XEM CHI TIẾT</a>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>