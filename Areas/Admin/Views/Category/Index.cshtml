@model IEnumerable<Category>
@{
    ViewData["Title"] = "Danh mục sản phẩm";
    Layout = "_LayoutAdmin";
}

<div class="container-fluid">
    <h1 class="page-header">Danh mục sản phẩm</h1>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <a asp-action="Create" class="btn btn-primary" style="margin-bottom:15px;">+ Thêm danh mục</a>

    <table class="table table-bordered table-striped">
        <thead>
            <tr><th>Tên danh mục</th><th>Mô tả</th><th></th></tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Description</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Sửa</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Xóa</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>