                    Dashboard
                </a>
            </li>
            <li style="@(currentController == "Category" ? "background-color:#eeeeee;" : "")">
                <a asp-area="Admin" asp-controller="Category" asp-action="Index"><i class="fa fa-list fa-fw"></i> Danh
                    mục
                </a>
            </li>
            <li style="@(currentController == "Product" ? "background-color:#eeeeee;" : "")">
                <a asp-area="Admin" asp-controller="Product" asp-action="Index"><i class="fa fa-cube fa-fw"></i> Sản
                    phẩm
                </a>
            </li>
            <li style="@(currentController == "Order" ? "background-color:#eeeeee;" : "")">
