@model IEnumerable<Product>
@{
    ViewData["Title"] = "Sản phẩm";
    Layout = "_LayoutAdmin";
}

<div class="container-fluid">
    <h1 class="page-header">Sản phẩm</h1>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <a asp-action="Create" class="btn btn-primary" style="margin-bottom:15px;">+ Thêm sản phẩm</a>

    <table class="table table-bordered table-striped">
        <thead>
            <tr><th>Ảnh</th><th>Tên sản phẩm</th><th>Danh mục</th><th>Giá</th><th></th></tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                    {
                        <img src="~/img/products/@item.ImageUrl" width="60" />
                    }
                </td>
                <td>@item.Name</td>
                <td>@(item.Category?.Name)</td>
                <td>@item.Price.ToString("N0") đ</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Sửa</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Xóa</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>